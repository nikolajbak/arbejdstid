rules_version = '2';

// Sikkerheden for Arbejdstid. Se docs/superpowers/specs/2026-10-07-login-og-sky-design.md
// og docs/superpowers/specs/2026-10-08-teams-design.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function egenEmail() {
      return request.auth.token.email.lower();
    }

    function godkendelse() {
      return /databases/$(database)/documents/godkendte/$(egenEmail());
    }

    // Logget ind, e-mail bekræftet og på listen over godkendte.
    function godkendt() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(godkendelse());
    }

    function admin() {
      return godkendt() && get(godkendelse()).data.admin == true;
    }

    function felter(paakraevet, tilladt) {
      return request.resource.data.keys().hasAll(paakraevet)
        && request.resource.data.keys().hasOnly(tilladt);
    }

    function kunAendret(nogler) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(nogler);
    }

    // --- Felterne i brugerens og teamets data ---------------------------------------

    function gyldigtUr(u) {
      return u == null || (u is map
        && u.keys().hasAll(['kundeId', 'opgavetypeId', 'start'])
        && u.keys().hasOnly(['kundeId', 'opgavetypeId', 'start', 'note', 'deltagere'])
        && u.kundeId is string
        && u.opgavetypeId is string
        && u.start is string
        && (!('note' in u) || u.note is string)
        && (!('deltagere' in u) || u.deltagere is list));
    }

    function gyldigKunde() {
      let d = request.resource.data;
      return felter(['navn', 'timepris', 'arkiveret'], ['navn', 'timepris', 'arkiveret', 'farve'])
        && (!('farve' in d) || d.farve in ['skov', 'ler', 'indigo', 'blomme', 'rosa', 'okker', 'hav', 'skifer'])
        && d.navn is string
        && d.navn.size() > 0
        && d.timepris is number
        && d.timepris >= 0
        && d.arkiveret is bool;
    }

    function gyldigType() {
      let d = request.resource.data;
      return felter(['navn', 'arkiveret'], ['navn', 'arkiveret'])
        && d.navn is string
        && d.navn.size() > 0
        && d.arkiveret is bool;
    }

    // Feltreglerne for en registrering; felterne selv tjekkes af kaldet.
    function gyldigReg() {
      let d = request.resource.data;
      return d.kundeId is string
        && d.opgavetypeId is string
        && d.start is string
        && d.slut is string
        && d.slut > d.start
        && d.timepris is number
        && d.timepris >= 0
        && (!('note' in d) || d.note is string);
    }

    // Udgifter, brændstof, kontantudlæg og betalinger på en kunde.
    function gyldigPost() {
      let d = request.resource.data;
      return felter(['kundeId', 'type', 'dato', 'beloeb', 'note'], ['kundeId', 'type', 'dato', 'beloeb', 'note'])
        && d.kundeId is string
        && d.type in ['udgift', 'braendstof', 'kontant', 'betaling']
        && d.dato is string
        && d.dato.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.beloeb is number
        && d.beloeb > 0
        && d.note is string;
    }

    match /godkendte/{email} {
      allow get: if (request.auth != null && email == egenEmail()) || admin();
      allow list: if admin();

      allow create: if admin()
        && felter(['email', 'admin', 'inviteret', 'uid'], ['email', 'admin', 'inviteret', 'uid'])
        && request.resource.data.email == email
        && request.resource.data.admin is bool
        && request.resource.data.inviteret is timestamp
        && request.resource.data.uid == null;

      allow delete: if admin() && email != egenEmail();

      allow update: if
        // Admin ændrer andres administratorrettighed.
        (admin() && email != egenEmail()
          && kunAendret(['admin'])
          && request.resource.data.admin is bool)
        // Brugeren markerer sin egen konto som oprettet.
        || (godkendt() && email == egenEmail()
          && kunAendret(['uid'])
          && resource.data.get('uid', null) == null
          && request.resource.data.uid == request.auth.uid);
    }

    match /brugere/{uid} {
      function eget() {
        return godkendt() && request.auth.uid == uid;
      }

      allow read: if eget();
      allow create, update: if eget()
        && felter(['email', 'oprettet', 'ur'], ['email', 'oprettet', 'ur', 'skjult'])
        && request.resource.data.email is string
        && (!('skjult' in request.resource.data) || request.resource.data.skjult is map)
        && request.resource.data.oprettet is timestamp
        && gyldigtUr(request.resource.data.ur);

      match /kunder/{id} {
        allow read, delete: if eget();
        allow create, update: if eget() && gyldigKunde();
      }

      match /opgavetyper/{id} {
        allow read, delete: if eget();
        allow create, update: if eget() && gyldigType();
      }

      match /registreringer/{id} {
        allow read, delete: if eget();
        allow create, update: if eget()
          && felter(['kundeId', 'opgavetypeId', 'start', 'slut', 'timepris'],
                    ['kundeId', 'opgavetypeId', 'start', 'slut', 'timepris', 'note'])
          && gyldigReg();
      }

      match /poster/{id} {
        allow read, delete: if eget();
        allow create, update: if eget() && gyldigPost();
      }
    }

    // --- Teams: alle medlemmer ser og skriver alt i teamet ------------------------------

    match /teams/{teamId} {
      function team() {
        return get(/databases/$(database)/documents/teams/$(teamId)).data;
      }

      function medlem() {
        return godkendt() && request.auth.uid in team().medlemmer;
      }

      function gyldigtTeam() {
        let d = request.resource.data;
        return felter(['navn', 'medlemmer', 'navne', 'inviterede', 'oprettet'], ['navn', 'medlemmer', 'navne', 'inviterede', 'oprettet'])
          && d.navn is string
          && d.navn.size() > 0
          && d.medlemmer is list
          && d.navne is map
          && d.inviterede is list
          && d.oprettet is timestamp;
      }

      // Læses af medlemmer og inviterede, også som forespørgsel.
      allow get, list: if godkendt()
        && (request.auth.uid in resource.data.medlemmer || egenEmail() in resource.data.inviterede);

      allow create: if godkendt() && gyldigtTeam()
        && request.resource.data.medlemmer == [request.auth.uid]
        && request.resource.data.navne.keys().hasOnly([request.auth.uid])
        && request.resource.data.navne[request.auth.uid] is string;

      allow update: if godkendt() && gyldigtTeam() && (
        // Et medlem må ændre navn, navne og invitationer og fjerne, men ikke tilføje, medlemmer.
        (request.auth.uid in resource.data.medlemmer
          && kunAendret(['navn', 'navne', 'inviterede', 'medlemmer'])
          && request.resource.data.medlemmer.toSet().difference(resource.data.medlemmer.toSet()).size() == 0)
        // En inviteret bliver medlem: tilføjer kun sig selv og fjerner kun sin egen invitation.
        || (egenEmail() in resource.data.inviterede
          && !(request.auth.uid in resource.data.medlemmer)
          && kunAendret(['medlemmer', 'inviterede', 'navne'])
          && request.resource.data.medlemmer.toSet() == resource.data.medlemmer.toSet().union([request.auth.uid].toSet())
          && request.resource.data.inviterede.toSet() == resource.data.inviterede.toSet().difference([egenEmail()].toSet())
          && request.resource.data.navne.diff(resource.data.navne).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.navne[request.auth.uid] is string)
      );

      // Hvert medlems ur og skjulte genveje i teamet.
      match /personer/{uid} {
        allow read: if medlem();
        allow create, update: if medlem() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['ur', 'skjult'])
          && gyldigtUr(request.resource.data.get('ur', null))
          && (!('skjult' in request.resource.data) || request.resource.data.skjult is map);
      }

      match /kunder/{id} {
        allow read, delete: if medlem();
        allow create, update: if medlem() && gyldigKunde();
      }

      match /opgavetyper/{id} {
        allow read, delete: if medlem();
        allow create, update: if medlem() && gyldigType();
      }

      match /registreringer/{id} {
        allow read, delete: if medlem();
        allow create, update: if medlem()
          && felter(['kundeId', 'opgavetypeId', 'start', 'slut', 'timepris', 'person'],
                    ['kundeId', 'opgavetypeId', 'start', 'slut', 'timepris', 'note', 'person'])
          && gyldigReg()
          // En rettelse må beholde en person, der siden er fjernet fra teamet.
          && (request.resource.data.person in team().medlemmer
            || (resource != null && request.resource.data.person == resource.data.person));
      }

      match /poster/{id} {
        allow read, delete: if medlem();
        allow create, update: if medlem() && gyldigPost();
      }
    }
  }
}
